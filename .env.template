# UniBooks-BE 環境變數鍵名清單（backend-ssd §8.1）
# 使用方式：複製為 .env 並填入實際值；.env 不得進入版控。
# 本檔僅列鍵名，不得含任何實際值。
# 測試／CI 如需隔離 .env，設 DJANGO_READ_DOT_ENV_FILE=0。

# ---- 必填、無預設（缺失或空值即拒絕啟動；禁止預設值／寫死值／自動生成）----
SECRET_KEY=
JWT_SIGNING_KEY=
SQS_QUEUE_URL=
GOOGLE_BOOKS_API_KEY=

# ---- 開發回退（僅 DEBUG=True 允許缺省；DEBUG=False 缺省＝啟動失敗）----
# 未設 POSTGRES_DATABASE → 回退 SQLite（db.sqlite3）＋警告
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
DB_PORT=
# Postgres SSL mode passed to psycopg2 (default: "require" for Neon pooler).
# Override to "disable" for local dev databases without SSL (e.g. the
# postgres:16-alpine image used by UniBooks's Docker Compose setup).
POSTGRES_SSLMODE=
# 未設 REDIS_URL → 回退 LocMemCache ＋警告（限流與 JWT 白名單僅單程序有效）
REDIS_URL=
# Cloudflare R2（S3 相容 API），用於商品照片／頭貼上傳。五項須「全部設定或全不
# 設定」——只設定部分會直接拒絕啟動（避免半套設定誤判為已就緒）。全不設定時
# 回退本機 FileSystemStorage（media/）＋警告，僅限本機開發。
# R2_ACCOUNT_ID：Cloudflare 帳號 ID（用於組出 endpoint_url）
R2_ACCOUNT_ID=
# R2 API Token 的 Access Key ID / Secret Access Key（R2 → Manage API Tokens）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 bucket 名稱
R2_BUCKET=
# Mailjet（教育信箱／註冊信箱驗證信）。兩項須「全部設定或全不設定」——只設一項
# 會直接拒絕啟動。全不設定時回退 console 後端（信件內容印到終端機，不會真的寄出），
# 僅限本機開發。金鑰取得：Mailjet → Account Settings → REST API → API Key Management
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# 對外信件寄件地址；DEBUG=False 時必填，未設定會拒絕啟動
# （本機 DEBUG=True 未設定時退回 noreply@localhost 並發出警告）
DEFAULT_FROM_EMAIL=

# 物件的公開存取網址（自訂網域，或 bucket 設定的 r2.dev 公開開發網址）；
# R2 bucket 預設不對外公開，缺少此值上傳的檔案將無法從瀏覽器讀取
R2_PUBLIC_URL=

# Bootstraps an initial superuser on a fresh DEBUG=False deployment with no
# admin account yet. Both must be set, or neither — setting only one fails
# startup instead of silently skipping or crashing. Ignored entirely when
# DEBUG=True, and a no-op once any superuser already exists.
DEFAULT_SUPERUSER_EMAIL=
DEFAULT_SUPERUSER_PASSWORD=
# Optional, cosmetic only (default: "Admin" / "")
DEFAULT_SUPERUSER_FIRST_NAME=
DEFAULT_SUPERUSER_LAST_NAME=

# Bearer secret an external scheduler must send to trigger POST/GET
# /api/cron/waitlist-notify/. Unset → the endpoint always refuses (403).
# If deployed on Vercel (this project's vercel.json already deploys the whole
# Django app there), set this as a Vercel project env var of the same name —
# Vercel Cron automatically sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# ---- 一般組態（非金鑰類，允許安全預設）----
DEBUG=
# 放寬 API 限流（選填，設為 1 才生效）
# 僅供需要大量連續操作的本機工具使用（例如自動化錄影腳本）。
# 刻意與 DEBUG 分開：測試是以 DEBUG=True 執行的，若用 DEBUG 當開關，
# 所有限流測試會改為斷言放寬後的數字，等於失去防護意義。
# production 絕不設定此變數。
RELAX_THROTTLES=
ALLOWED_HOSTS=
# 前端網址：用於信件內連結（信箱驗證）；
# 未設定時預設 http://localhost:4200（本機開發用）
FRONTEND_URL=

# CFEdgeChat（Cloudflare Workers 即時聊天微服務）；需與 CFEdgeChat 專案的
# EDGE_CHAT_JWT_SECRET（wrangler secret / .dev.vars）一致
EDGE_CHAT_JWT_SECRET=
EDGE_CHAT_URL=
# ISBNnet Resolver（Cloudflare Worker 微服務，用於國家圖書館 ISBN 精確查詢）；
# 未設定時預設 http://localhost:8789（本機開發用）
ISBNNET_RESOLVER_URL=
# CFEdgeChat webhook 共享密鑰；Worker 回呼時須帶 X-Webhook-Secret 表頭比對；
# 未設定時 webhook 端點拒絕所有請求（回 403）
EDGE_CHAT_WEBHOOK_SECRET=
# 房間層 JWT 的 app_id claim，須與前端 message.service.ts 建構
# /ws/<app_id>/<room_id>、/api/<app_id>/<room_id>/... 網址時所用的 appId 一致
# （目前為固定字串 "unibooks"）；非機密設定，未設定時預設為 "unibooks"
EDGE_CHAT_APP_ID=

# Google OAuth 用戶端 ID (用於前端 GIS 按鈕初始化與後端驗證 ID Token)
GOOGLE_CLIENT_ID=

# 功能上應該是沒用
GOOGLE_CLIENT_SECRET=