{
    "version": 2,
    "builds": [
        {
            "src": "unibooks/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.14",
                "maxDuration": 10
            }
        },
        {
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles_build"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "unibooks/wsgi.py"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/waitlist-notify/",
            "schedule": "0 0 * * *"
        }
    ]
}